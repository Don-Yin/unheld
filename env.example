# PayPal sandbox REST app (developer.paypal.com). Enable "Transaction search" on the app.
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# PayPal sandbox test card, used by `npm run seed` to pay the merchant without a buyer login.
PAYPAL_TEST_CARD=
PAYPAL_TEST_CARD_EXPIRY=
PAYPAL_TEST_CARD_CVV=

# Optional: AG Studio licence key. Without it, a trial watermark shows.
AG_STUDIO=

# Optional: the AG Studio AI assistant (lib/ai/provider.ts). Without a key it is hidden.
# AI_PROVIDER is openrouter, openai or local; give an OpenRouter key a daily credit limit.
AI_PROVIDER=openrouter
AI_API_KEY=
# Comma-separated model ids for the picker; the first is the default (blank: the provider's default).
AI_MODELS=
# Assistant turns allowed per UTC day on this server (blank or 0: no count).
AI_DAILY_LIMIT=200

# Optional: Gmail evidence (lib/gmail.ts). Without these, the evidence widget shows no gmail rows.
# OAuth client for the Gmail API ("In production", unverified is fine for your own mailbox).
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Offline refresh token for the mailbox above.
GMAIL_REFRESH_TOKEN=
# The mailbox address itself; `npm run seed` writes the demo mail as and to this address.
GMAIL_TEST_ADDRESS=

# Optional: a long random string gating every page and /api/* route. Leave unset for an open local run.
ACCESS_CODE=
